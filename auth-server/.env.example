# Copy to .env and edit.
PORT=8080
HOST=0.0.0.0
# REQUIRED. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
KEY_PREFIX=PHX
# Loaders sending a lower "version" get status "outdated". 0 = disabled.
MIN_LOADER_VERSION=0
# Set to 1 only when behind nginx / Caddy / Cloudflare.
TRUST_PROXY=0
AUTH_RATE_PER_MINUTE=20
ADMIN_RATE_PER_MINUTE=60
# DATA_DIR=./data
